<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form wizard Chi tiền ngân hàng nhanh -->
    <record id="view_bank_payment_wizard_form" model="ir.ui.view">
        <field name="name">bank.payment.wizard.form</field>
        <field name="model">bank.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Chi Tiền Ngân Hàng">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span class="text-danger">🏦 Chi Tiền Ngân Hàng</span>
                        </h1>
                    </div>
                    <group col="2">
                        <group string="Thông tin chứng từ">
                            <field name="date"/>
                            <field name="journal_id" options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Đối tượng &amp; Số tiền">
                            <field name="partner_id"
                                   options="{'no_create': True}"
                                   placeholder="Chọn đối tượng..."/>
                            <field name="amount" widget="monetary"/>
                        </group>
                    </group>
                    <group col="2">
                        <group string="Hạch toán">
                            <field name="account_id"
                                   domain="[('deprecated', '=', False)]"
                                   placeholder="TK331, TK641, TK642..."
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Diễn giải">
                            <field name="ly_do" placeholder="Lý do chi tiền..."/>
                            <field name="dien_giai" placeholder="Diễn giải chi tiết..."/>
                        </group>
                    </group>
                    <group col="2">
                        <group string="Phân tích">
                            <field name="ma_thong_ke_id" options="{'no_create': True}"/>
                            <field name="khoan_muc_id" options="{'no_create': True}"/>
                            <field name="cong_trinh_id" options="{'no_create': True}"/>
                        </group>
                        <group/>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        <strong>Hạch toán tự động:</strong>
                        Nợ TK <em>đối ứng</em> đã chọn / Có TK <em>Ngân hàng</em>
                    </div>
                </sheet>
                <footer>
                    <button name="action_tao_phieu_chi"
                            string="✅ Tạo Phiếu Chi"
                            type="object"
                            class="btn-danger"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action mở wizard Chi tiền ngân hàng nhanh -->
    <record id="action_bank_payment_wizard" model="ir.actions.act_window">
        <field name="name">Chi Tiền Ngân Hàng</field>
        <field name="res_model">bank.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
